# Copy outside the checkout and set these paths once. No credentials in this file.
# Use your own entry in runbook/profiles/.
TRL_PROFILE=your_registered_profile
TRL_BASE=/absolute/path/to/your/experiment
TRL_VENV=/absolute/path/to/training-venv
TRL_MODEL=/absolute/path/to/Qwen3.5-9B
SWE_TB2_VAL_DATA=/absolute/path/to/tb2_1_eval.jsonl
SYNTH_ENV_FILE=/absolute/path/to/synthesis-credentials.env

# Six reserved B300 GPUs: two trainer, three rollout, one dedicated evaluation.
RL_GPUS=0,1,2,3,4,5
SWE_DP_SHARD=2
SWE_GEN_DP=3
SWE_NUM_EVAL_GENERATORS=1
SWE_EVAL_GEN_DP=1
SWE_VAL_SAMPLES=89
SWE_TB2_VAL_K=5
SWE_VAL_INTERVAL=20
EVOLVE_WORKERS=2
RL_OBSERVE_REWARDS=1
