# Source after the run's normal environment (or use a later EnvironmentFile).
# Five independent single-GPU meshes. Keep trainer, eval, data, concurrency,
# checkpoint, and GPU placement settings in the run's existing environment.
# GPU count = SWE_DP_SHARD + 5 * 1 + eval replicas * eval DP width.
# Every engine returns directly to the controller's sticky/least-load router.
# No cross-engine per-step collective or peer-result fan-in runs in this layout.
SWE_NUM_GENERATORS=5
SWE_GEN_DP=1
SWE_DP_FALLBACK_ROUTER=leastloaded
SWE_DP_STICKY_REBALANCE=0
