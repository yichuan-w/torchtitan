# Yichuan's roots on della-tridao. Selected with TRL_PROFILE=yichuan.
# Plain KEY=VALUE, no expansion (systemd EnvironmentFile= reads it too). The
# ambient environment wins over every line here, so a per-run TRL_BASE or
# SWE_PROMPT_DATA exported before launch_9b.sh still takes effect.
# The checkout is the one his sessions commit and push from. The data root is
# created by the launcher on first use; the mix under it is his to build, and
# until it exists a launch stops at the data check with that path in the message.
TRL_BASE=/scratch/gpfs/TRIDAO/al9080/andy-rl-tb/terminal-rl
TRL_TT=/scratch/gpfs/TRIDAO/al9080/andy-rl-tb/torchtitan
SWE_PROMPT_DATA=/scratch/gpfs/TRIDAO/al9080/andy-rl-tb/terminal-rl/data/mix/mix_live.jsonl
SWE_TASK_EVOLUTION_DIR=/scratch/gpfs/TRIDAO/al9080/andy-rl-tb/terminal-rl/evolution/signals
