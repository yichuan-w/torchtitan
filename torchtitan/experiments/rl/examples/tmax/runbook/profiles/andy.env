# Zhifei's roots on della-tridao. Selected with TRL_PROFILE=andy.
# Plain KEY=VALUE, no expansion (systemd EnvironmentFile= reads it too). The
# ambient environment wins over every line here, so a per-run TRL_BASE or
# SWE_PROMPT_DATA exported before launch_9b.sh still takes effect.
TRL_BASE=/scratch/gpfs/TRIDAO/al9080/terminal-rl
TRL_TT=/home/al9080/torchtitan
SWE_PROMPT_DATA=/scratch/gpfs/TRIDAO/al9080/terminal-rl/data/mix/mix_live.jsonl
SWE_TASK_EVOLUTION_DIR=/scratch/gpfs/TRIDAO/al9080/terminal-rl/evolution/signals
