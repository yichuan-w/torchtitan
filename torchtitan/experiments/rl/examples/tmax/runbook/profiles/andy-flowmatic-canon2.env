# Zhifei's flow-matic root for the Sonnet 5.5 re-run with the stated-conditions rule
# (branch evolve-stated-conditions): the same evolve root as andy-flowmatic, from its own
# worktree. Selected with TRL_PROFILE=andy-flowmatic-canon2.
TRL_BASE=/var/tmp/tw-eval/evolve
TRL_TT=/var/tmp/tw-eval/tt-canon2
