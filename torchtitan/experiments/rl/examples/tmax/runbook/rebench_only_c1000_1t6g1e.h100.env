# Portable recipe snapshot for the 200-step Qwen3.5-9B ReBench-only baseline.
#
# This file records model, optimization, rollout, evaluation, and sandbox knobs.
# It deliberately contains no credentials, user names, service configuration, or
# machine-specific paths. Before sourcing it, set SWE_PROMPT_DATA to the 1,317-row
# ReBench JSONL and SWE_TB2_VAL_DATA to the 89-row Terminal-Bench 2.1 JSONL.
# A platform launcher must provide one 8-GPU H100 trainer host, six 8-GPU H100
# training-generator hosts, and one 8-GPU H100 evaluation-generator host.

# Keep the training corpus fixed for the baseline. The separately launched
# evolution loop is not part of this experiment.
SWE_HOLDOUT_N=0
SWE_DATA_HOT_RELOAD=0

# Terminus-2 agent and context limits.
TMAX_AGENT=terminus
TMAX_TERMINUS_MAX_TURNS=120
SWE_MAX_CONTEXT_LEN=63488
TMAX_TURN_MAX_TOKENS=32768
TMAX_EXEC_TIMEOUT_SEC=120
TMAX_EVAL_TIMEOUT_SEC=600
SWE_TIME_BUDGET_SEC=2400
SWE_AGENT_TIMEOUT_FLOOR_SEC=7200

# H100 topology: 8 trainer GPUs, 48 rollout GPUs, and 8 evaluation GPUs.
SWE_DP_SHARD=8
SWE_GEN_DP=8
SWE_NUM_GENERATORS=6
SWE_NUM_EVAL_GENERATORS=1
SWE_EVAL_GEN_DP=8

# Async DPPO batch and admission policy.
SWE_NUM_GROUPS_PER_TRAIN_STEP=32
SWE_GROUP_SIZE=12
SWE_DROP_ZERO_STD=1
SWE_OFFPOLICY_STEPS=4
SWE_MAX_ACTIVE_GROUPS=160
SWE_INITIAL_ACTIVE_GROUPS=128
# Empty means take-any selection rather than a sliding prefix window.
SWE_SELECTION_WINDOW_GROUPS=
SWE_ROLLOUT_CONCURRENCY=1000
SWE_NUM_ROLLOUT_WORKERS=16
SWE_MAX_NUM_SEQS=32

# Trainer and generator numerics.
SWE_LOSS=dppo
SWE_LR=3e-6
SWE_AC=full
SWE_LOSS_CHUNKS=32
SWE_LMHEAD_TF32=1
SWE_GEN_BACKEND=vllm_native
SWE_GEN_PREFIX_CACHE=1
SWE_GEN_VLLM_DEFAULT_COMPILE=1
SWE_GPU_MEM_LIMIT=0.88
SWE_DISABLE_CUSTOM_ALL_REDUCE=1
VLLM_ALLREDUCE_USE_FLASHINFER=0
VLLM_USE_FLASHINFER_SAMPLER=0

# Training, checkpointing, and held-out Terminal-Bench 2.1 evaluation.
SWE_TRAIN_STEPS=200
SWE_CKPT_INTERVAL=5
SWE_CKPT_KEEP=2
SWE_CKPT_ASYNC=async
SWE_VAL_INTERVAL=20
SWE_VAL_SAMPLES=89
SWE_TB2_VAL_K=5
SWE_NUM_EVAL_ROLLOUT_WORKERS=4
SWE_EVAL_ROLLOUT_CONCURRENCY=64
SWE_VAL_TRACES=1

# Daytona allocation and lifecycle.
TT_DAYTONA_EPHEMERAL=1
TT_DAYTONA_CPU=1
TT_DAYTONA_MEM_GB=2
TT_DAYTONA_MAX_MEM_GB=8
TT_DAYTONA_DISK_GB=2
TT_DAYTONA_CREATE_CONCURRENCY=8
TT_DAYTONA_CREATE_RETRIES=8
TT_DAYTONA_HEARTBEAT_SEC=180
TT_DAYTONA_AUTO_DELETE_MIN=15
TT_DAYTONA_TTL_MIN=480
SWE_PREFLIGHT_FANOUT=4
