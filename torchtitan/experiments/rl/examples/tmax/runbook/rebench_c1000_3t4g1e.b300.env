# B300 overlay: train SWE-Rebench (+ TMax reaudit mix), eval TB 2.1.
# 3 trainer + 4 independent DP1 generators + 1 eval GPU.
# Source this then exec launch_9b.sh; already-exported values win.

HF_HOME=/ssd2/k3/yichuan/hf
FLASHINFER_CACHE_DIR=/ssd2/k3/yichuan/rl/.flashinfer-cache
TRITON_CACHE_DIR=/ssd2/k3/yichuan/rl/.triton-cache
PYTHONFAULTHANDLER=1

TRL_PROFILE=yichuan-b300
TRL_BASE=/ssd2/k3/yichuan/rl-rebench
TRL_TT=/ssd1/k3/yichuan/torchtitan
TRL_VENV=/ssd1/k3/yichuan/titan-rl
TRL_MODEL=/ssd2/k3/yichuan/models/Qwen3.5-9B
TRL_CKPT_EXPORT=0
TRL_CKPT_MIRROR=0

# No RL_DATA: the run reads $TRL_BASE/data/mix/live.jsonl, which new_root.py
# --data-release publishes, and launch.json then records its mix version.
RL_GPUS=0,2,4,5,6,7,1,3
RL_OBSERVE_REWARDS=0

WANDB_PROJECT=terminal-agent-rl
WANDB_NAME='rebench 9b c1000 3t4g1e tb21 from scratch 64k'

SWE_AC=full
SWE_AGENT_TIMEOUT_FLOOR_SEC=7200
SWE_CKPT_FOLDER=/ssd2/k3/yichuan/rl-rebench/ckpt
SWE_CKPT_INTERVAL=5
SWE_CKPT_KEEP=2
SWE_DATA_HOT_RELOAD=0
SWE_DISABLE_CUSTOM_ALL_REDUCE=1
SWE_DP_FALLBACK_ROUTER=leastloaded
SWE_DP_SHARD=3
SWE_DP_STICKY_REBALANCE=0
SWE_DROP_ZERO_STD=0
SWE_EVAL_GEN_DP=1
SWE_EVAL_ROLLOUT_CONCURRENCY=64
SWE_EVOLUTION_SIGNALS=0
SWE_GEN_BACKEND=vllm_native
SWE_GEN_DP=1
SWE_GEN_PREFIX_CACHE=1
SWE_GEN_VLLM_DEFAULT_COMPILE=1
SWE_GEN_VLLM_ATTENTION=FLASH_ATTN
SWE_GPU_MEM_LIMIT=0.88
SWE_GROUP_SIZE=12
SWE_HOLDOUT_N=0
SWE_INITIAL_ACTIVE_GROUPS=128
SWE_LMHEAD_TF32=1
SWE_LOSS_CHUNKS=32
SWE_LR=3e-6
SWE_MAX_ACTIVE_GROUPS=160
SWE_MAX_CONTEXT_LEN=63488
SWE_NUM_EVAL_GENERATORS=1
SWE_NUM_EVAL_ROLLOUT_WORKERS=4
SWE_NUM_GENERATORS=4
SWE_NUM_GROUPS_PER_TRAIN_STEP=32
SWE_NUM_ROLLOUT_WORKERS=16
SWE_ROLLOUT_CONCURRENCY=1000
SWE_ROLLOUT_RECORDS=1
SWE_TB2_VAL_DATA=/ssd2/k3/yichuan/rl/data/tb2_1_eval.jsonl
SWE_TB2_VAL_K=5
SWE_TIME_BUDGET_SEC=2400
SWE_TRAIN_STEPS=150
SWE_VAL_INTERVAL=20
SWE_VAL_SAMPLES=89

TMAX_AGENT=terminus
TMAX_EXEC_TIMEOUT_SEC=120
TMAX_TERMINUS_MAX_TURNS=120
TMAX_TURN_MAX_TOKENS=32768

TT_DAYTONA_AUTO_DELETE_MIN=15
TT_DAYTONA_CPU=1
TT_DAYTONA_CREATE_CONCURRENCY=8
TT_DAYTONA_CREATE_RETRIES=8
TT_DAYTONA_DISK_GB=2
TT_DAYTONA_EPHEMERAL=1
TT_DAYTONA_HEARTBEAT_SEC=180
# Set here so rltrain.env's new_titan_swe_r2e, another run's owner label, does not apply.
TT_DAYTONA_LABEL=titan_swe_r2e
TT_DAYTONA_MAX_MEM_GB=8
TT_DAYTONA_MEM_GB=2
# rltrain.env's 300 min is sized for training rollouts. A TB 2.1 eval sandbox can
# live 7200 s agent floor + up to 12000 s verifier + boot, past 300 min.
TT_DAYTONA_TTL_MIN=480

VLLM_ALLREDUCE_USE_FLASHINFER=0
VLLM_USE_FLASHINFER_SAMPLER=0
