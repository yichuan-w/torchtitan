# Environment for the reference 9B TerminalWorld run.
#
# Every value here is the value the live run had set, copied from the run's own
# dump (runs/tw-mix-take7-<stamp>/launch.info), not a suggestion. Where a name is
# absent from this file the code default applies and that was deliberate.
#
# systemd reads this via EnvironmentFile=. It is plain KEY=VALUE: no `export`, no
# shell expansion, no quotes-with-spaces. launch_9b.sh reads the same names from
# the ambient environment, so `set -a; . rltrain.env; set +a` works too.
#
# CREDENTIALS ARE NOT IN THIS FILE and must not be added to it. DAYTONA_API_KEY
# (and OPENAI_API_KEY if you run the evolution loop) come from somewhere the repo
# cannot see -- on our box, `. ~/.config/daytona/env` inside the launcher.

# ---- paths (the three things that certainly differ on your machine) ----------
# Root for data, runs, logs, evolution state.
TRL_BASE=/scratch/gpfs/TRIDAO/al9080/terminal-rl
# torchtitan checkout. Goes on PYTHONPATH; NOT pip-installed.
TRL_TT=/home/al9080/torchtitan-yichuan
# Model directory (HF layout, `hf download Qwen/Qwen3.5-9B`).
TRL_MODEL=/scratch/gpfs/TRIDAO/al9080/models/Qwen3.5-9B

# ---- GPU placement ----------------------------------------------------------
# Five GPUs, not eight, because this box is shared with another user -- it is not
# a claim that five is right. The split is SWE_DP_SHARD (trainer) + SWE_GEN_DP
# (generator engines), and they must sum to the GPU count. On an idle 8x B300 the
# obvious change is RL_GPUS=0..7 with a larger SWE_DP_SHARD/SWE_GEN_DP; we have
# not run that, so the numbers below are the ones with evidence behind them.
# RL_GPUS is used verbatim and need not be contiguous; the allocator gives each
# mesh its slice of the list BY POSITION. The trainer takes the first
# SWE_DP_SHARD entries and then one entry per generator, so on a shared host put
# the quietest GPUs in the generator positions. RL_GPU_OFFSET is the older
# consecutive-window knob and applies only when RL_GPUS is unset.
RL_GPUS=0,1,2,3,4
SWE_DP_SHARD=2
SWE_GEN_DP=3

# ---- data -------------------------------------------------------------------
SWE_PROMPT_DATA=/scratch/gpfs/TRIDAO/al9080/terminal-rl/data/mix/mix_live.jsonl
SWE_TB2_VAL_DATA=/scratch/gpfs/TRIDAO/al9080/terminal-rl/data/mix/tb2_eval.jsonl
# Re-read the training JSONL mid-run when its mtime changes. Required if the
# evolution loop is running; harmless otherwise.
SWE_DATA_HOT_RELOAD=1

# ---- GRPO shape -------------------------------------------------------------
SWE_NUM_GROUPS_PER_TRAIN_STEP=32
SWE_GROUP_SIZE=16
# 160 = (max_offpolicy_steps + 1) * SWE_NUM_GROUPS_PER_TRAIN_STEP, the size the
# staleness cap implies. 512 let the window grow to ~248 groups and stop
# mattering; 160 keeps the buffer coupled to the staleness the recipe tolerates.
SWE_MAX_ACTIVE_GROUPS=160
# Cold-start value only: the buffer grows on its own, one slot per trainable
# group taken. Raising it shortens the ramp and nothing else.
SWE_INITIAL_ACTIVE_GROUPS=64
# SWE_SELECTION_WINDOW_GROUPS deliberately unset -> take-any.
SWE_TRAIN_STEPS=150
SWE_LR=3e-6
# 0 = KEEP zero-variance groups. Code default is 1 (drop them). Off here because
# the evolution loop re-tunes those prompts instead of discarding them; dropping
# and evolving the same group shrinks the batch by exactly what you meant to fix.
# Keep 0 even WITHOUT evolution: config_registry.py sets
# skip_zero_advantage_samples = not drop_zero_std_reward_groups, so with the drop
# off the group stays in the batch but its samples are filtered out of the forward
# pass -- it costs no compute, fills the batch faster, and (controller.py:1949)
# still grows the active-group buffer, which a dropped group does not. See
# RUNBOOK-yichuan-B300.md "Zero-variance groups" for the measured case.
SWE_DROP_ZERO_STD=0

# ---- agent and context ------------------------------------------------------
TMAX_AGENT=terminus
TMAX_TERMINUS_MAX_TURNS=120
SWE_MAX_CONTEXT_LEN=63488
TMAX_TURN_MAX_TOKENS=32768
TMAX_EXEC_TIMEOUT_SEC=120
SWE_TIME_BUDGET_SEC=2400
# Raise a task's own declared agent budget to this floor, never lower it. Many
# TerminalWorld tasks declare 900s, far too short for a 120-turn episode.
SWE_AGENT_TIMEOUT_FLOOR_SEC=900

# ---- generator --------------------------------------------------------------
# vllm_native, not torchtitan_wrapper: on B300 the wrapper's varlen path trips
# an FA4-cute assert ("page_table is not supported with cu_seqlens_k").
SWE_GEN_BACKEND=vllm_native
SWE_GPU_MEM_LIMIT=0.85
# 256 decode slots per engine. 512 was tried (KV sat at 38%) and collapsed the
# pipeline: doubling admission halved per-sequence decode speed (~6.6 -> 2.3
# tok/s), turns stopped fitting inside agent budgets, rollouts died at the guard
# and were replaced by fresh ones needing cold prefill -- 2198 errors vs 64
# completions in two hours. Deadline-driven agentic rollouts need per-turn
# latency, not more admission; leave this at 256 unless per-seq speed improves.
SWE_MAX_NUM_SEQS=256
SWE_GEN_PREFIX_CACHE=1
SWE_DISABLE_CUSTOM_ALL_REDUCE=1

# ---- rollout throughput -----------------------------------------------------
# 1536, not 3072: rollout concurrency is capped by the LLM side, not the sandbox
# side. 3 engines x 256 decode slots serve ~1500-1800 active turn streams; a 2x
# oversubscription adds only queueing, and queued first turns overrun the agent
# budget after every restart (776 turns=0 deaths at secs~1812 on the 05:57 08-29
# boot, first-turn wave ~46M prefill tokens deep).
SWE_ROLLOUT_CONCURRENCY=1536
SWE_NUM_ROLLOUT_WORKERS=16

# ---- reward -----------------------------------------------------------------
# SWE_WRONG_SUBMIT_PENALTY unset -> code default 0, no penalty. Set it to 0.3 to
# subtract that much when the agent submits and is wrong.

# ---- checkpoints ------------------------------------------------------------
# One 9B checkpoint is ~98 GiB. 24 x 98 GiB is ~2.3 TiB -- size your filesystem
# for it or lower SWE_CKPT_KEEP. The code default is 3.
SWE_CKPT_INTERVAL=5
SWE_CKPT_KEEP=8

# ---- inline validation ------------------------------------------------------
# 0 disables the periodic TB-2.0 pass. It is off here because with no dedicated
# eval generator the pass competes with rollout collection on the same 3 engines.
# To turn it on: SWE_VAL_SAMPLES=89 (the TB-2.0 set is 89 tasks).
SWE_VAL_SAMPLES=0
SWE_VAL_INTERVAL=20
SWE_NUM_EVAL_GENERATORS=0

# ---- Daytona sandboxes ------------------------------------------------------
TT_DAYTONA_EPHEMERAL=1
TT_DAYTONA_CPU=1
TT_DAYTONA_MEM_GB=2
TT_DAYTONA_MAX_MEM_GB=8
TT_DAYTONA_DISK_GB=2
TT_DAYTONA_CREATE_CONCURRENCY=128
TT_DAYTONA_CREATE_RETRIES=8
TT_DAYTONA_HEARTBEAT_SEC=180
TT_DAYTONA_AUTO_DELETE_MIN=15
TT_DAYTONA_LABEL=new_titan_swe_r2e

# ---- evolution loop (optional; see RUNBOOK section G) -----------------------
# The trainer only WRITES here. Unset it and the loop is inert; training is
# unaffected either way.
SWE_TASK_EVOLUTION_DIR=/scratch/gpfs/TRIDAO/al9080/terminal-rl/evolution/signals

# ---- logging ----------------------------------------------------------------
WANDB_PROJECT=terminal-agent-rl

# --- trainer speed knobs (added 2026-08-29 after span profiling; see RUNBOOK) ---
# SWE_LMHEAD_TF32 unset -> code default 0: the fp32 lm_head matmuls keep full
# fp32 inputs. Setting it to 1 puts TF32 tensor cores on them (fp32 accumulation
# and fp32 logit outputs are kept; only matmul inputs round to a 10-bit
# mantissa), worth ~9.5s of a 24s microbatch. Left off here to keep the lm_head
# at full input precision; turn it on when trainer step time is the constraint.
# Per-op selective activation checkpointing instead of the base FullAC. FullAC was
# sized for 80GB cards; a B300 trainer rank uses <60 of 288GB, so paying full
# forward recompute in every backward is waste. The fla GDN kernel is invisible to
# the SAC policy and is recomputed either way.
SWE_AC=selective
# 8 loss chunks instead of 32: larger lm_head GEMMs, fewer chunk-loop iterations,
# ~4GiB more per-chunk logits. Same loss math.
SWE_LOSS_CHUNKS=8
