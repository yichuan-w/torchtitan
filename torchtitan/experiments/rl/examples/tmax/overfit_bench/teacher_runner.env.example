# Hardware placement for a teacher-rewriter job on one shared 8 x B300 box (della-tridao), as the v12
# job ran from 10-28 17:11: trainer FSDP-5, two rollout generators, one readout generator, 8 GPUs.
# RL_GPUS (set at launch, not here) is read by position: the first SWE_DP_SHARD entries are the
# trainer, then one per generator, then the readout generator. Put the GPUs with the most free
# memory first. Copy to <job>/runner.env and adjust to what is free when you launch.
SWE_DP_SHARD=5
SWE_GEN_DP=1
SWE_NUM_GENERATORS=2
SWE_NUM_EVAL_GENERATORS=1
SWE_AC=full
SWE_LOSS_CHUNKS=128
# Each rank grows its cached memory to this at startup, so a co-tenant cannot take the trainer's
# peak before its first backward (three resumes OOMed that way). FSDP-5 fits in 92 GiB; FSDP-4
# needed ~105 GiB. A rank that cannot get it reserves less and logs how much it got.
SWE_TRAINER_RESERVE_GB=92
# vLLM takes this fraction of the whole GPU at startup and fails if that much is not free.
SWE_GPU_MEM_LIMIT=0.22
SWE_EVAL_GPU_MEMORY_LIMIT=0.21
SWE_CKPT_KEEP=2
TRL_CKPT_EXPORT=0
TRL_CKPT_MIRROR=0
HYPERACTOR_MESH_ORPHAN_TIMEOUT=10m
