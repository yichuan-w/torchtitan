# The overfit bench's fixed training recipe: every job, every rewriter, the same.
# Hardware placement (RL_GPUS, SWE_DP_SHARD, SWE_GEN_DP, SWE_NUM_GENERATORS,
# SWE_GPU_MEM_LIMIT, SWE_AC, SWE_LOSS_CHUNKS, checkpoint keep/export) is the
# runner's and lives in its own env file; start_training.sh reads both.
# Values are the raman single-seed run's (raman-evolve-20261011 train-tridao-v2.env).
SWE_GROUP_SIZE=8
SWE_NUM_GROUPS_PER_TRAIN_STEP=1
# One group in flight (lockstep, see config_registry): every step's attempts come
# from the latest policy and the latest published task, never from a group
# generated before the last update or publication.
SWE_INITIAL_ACTIVE_GROUPS=1
SWE_MAX_ACTIVE_GROUPS=1
SWE_ROLLOUT_CONCURRENCY=8
SWE_LR=5e-7
SWE_TRAIN_STEPS=800
# 2400 s per attempt on every task, TB4 included (whose tasks declare 8 h): the
# workspace rule that the rollout budget is a controlled variable, never raised.
SWE_TIME_BUDGET_SEC=2400
TMAX_CONTEXT_NOTICE_STYLE=v2
TMAX_CONTEXT_WARN_FRAC=0.7
# Readout: the original task alone, 16 attempts every 5 steps.
SWE_VAL_SAMPLES=1
SWE_TB2_VAL_K=16
SWE_TB2_VAL_TEMPERATURE=1.0
SWE_TB2_VAL_TOP_P=1.0
SWE_VAL_INTERVAL=5
SWE_VAL_ASYNC=1
SWE_CKPT_INTERVAL=5
# The rewriter's publications reach training only through the live mix.
SWE_DATA_HOT_RELOAD=1
SWE_ROLLOUT_RECORDS=1
SWE_EVOLUTION_SIGNALS=1
