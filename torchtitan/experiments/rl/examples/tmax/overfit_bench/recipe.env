# The overfit bench's fixed training recipe: every job, every rewriter, the same.
# Hardware placement (RL_GPUS, SWE_DP_SHARD, SWE_GEN_DP, SWE_NUM_GENERATORS,
# SWE_GPU_MEM_LIMIT, SWE_AC, SWE_LOSS_CHUNKS, checkpoint keep/export) is the
# runner's and lives in its own env file; start_training.sh reads both, this
# file first, and runbook/rltrain.env fills whatever neither sets.
SWE_GROUP_SIZE=12
SWE_NUM_GROUPS_PER_TRAIN_STEP=1
# A group whose attempts all fail or all pass trains nothing: drop it at the
# batcher so it does not take a step (runbook/rltrain.env would fill in 0, under
# which such a group took a step of zero gradient: 11 of v12's first 28 trained
# steps were such steps, and the 5-step readout cadence counted them).
SWE_DROP_ZERO_STD=1
# Eight groups in flight. A group's age is every step trained between its start
# and its end, including steps from groups that started after it and finished
# first, so 8 in flight does not bound it by 8: v12's g11 (r6, 5/12) started at
# policy 9, ended at 18 and was dropped as stale. 12 leaves room for a 2-hour
# group while the others step every 15-20 minutes.
SWE_INITIAL_ACTIVE_GROUPS=8
SWE_MAX_ACTIVE_GROUPS=8
SWE_OFFPOLICY_STEPS=12
# Every attempt of every group in flight starts at once: 8 groups x 12 = 96
# sandboxes. At 72, a quarter of the attempts queued behind the others, so a
# late group took up to ~3 hours and aged past the cap. The work-conserving
# check asks each worker for one group more than it can run (48 // 12 + 1 = 5,
# 10 in all) so no slot idles through a group's tail; here an idle slot is the
# accepted cost of no attempt waiting, hence SWE_ALLOW_IDLE_ROLLOUT_SLOTS.
SWE_NUM_ROLLOUT_WORKERS=2
SWE_ROLLOUT_CONCURRENCY=96
SWE_ALLOW_IDLE_ROLLOUT_SLOTS=1
SWE_LR=3e-6
SWE_TRAIN_STEPS=200
# Training draws from the scheduler's version pool (README.md, "Interface").
SWE_BENCH_SCHEDULER=1
# A training attempt has the main training run's caps: 120 turns, 2 h of wall
# clock and an 80K context, the same for every task whatever it declares (no
# SWE_AGENT_TIMEOUT_FLOOR_SEC). The readout keeps its own budget (README.md,
# "What the bench fixes"). SWE_MAX_CONTEXT_LEN is set here because
# runbook/rltrain.env would otherwise fill in its 63488.
SWE_BENCH_MAX_TURNS=120
SWE_BENCH_TRAIN_BUDGET_SEC=7200
SWE_TMAX_CONTEXT=81920
SWE_MAX_CONTEXT_LEN=79872
TMAX_AGENT=terminus
# Every sandbox -- training, readout and a separate verifier -- gets 4 vCPU.
# Memory and disk stay the row's (clamped to Daytona's 8 GiB / 10 GiB caps).
SWE_BENCH_SANDBOX_CPU=4
TMAX_CONTEXT_NOTICE_STYLE=v2
TMAX_CONTEXT_WARN_FRAC=0.7
# A training attempt that ends without submitting (context, time or turn limit) is
# scored at its verifier verdict too, as the readout scores it, instead of 0
# (Zhifei, 2026-10-26). On v11 none of the 210 unsubmitted attempts' shadow grades
# passed, so this changes no reward there; it makes training and readout one rule.
TMAX_GRADE_UNSUBMITTED_TRAIN=1
# Readout: the original task alone, 16 attempts every 5 steps, read as the current
# TB2.1 eval reads it (run 1022's 160K validation context, the RUNBOOK's 300-turn
# cap for it). The training caps above are training's only; a readout attempt
# gets 300 turns, 5400 s whatever the task declares (the eval's uniform budget:
# floor and cap both 5400), a 160K context and no context notice
# (SWE_EVAL_CONTEXT_NOTICE, off by default), and an unsubmitted attempt is
# scored at its verifier verdict (SWE_EVAL_GRADE_UNSUBMITTED, on by default).
SWE_BENCH_READOUT_EVAL_BUDGET=1
SWE_EVAL_MAX_TURNS=300
SWE_AGENT_TIMEOUT_FLOOR_SEC=5400
SWE_EVAL_AGENT_BUDGET_CAP_SEC=5400
SWE_EVAL_MAX_MODEL_LEN=163840
SWE_EVAL_MAX_CONTEXT_LEN=161792
SWE_VAL_SAMPLES=1
SWE_TB2_VAL_K=16
SWE_TB2_VAL_TEMPERATURE=1.0
SWE_TB2_VAL_TOP_P=1.0
SWE_VAL_INTERVAL=5
SWE_VAL_ASYNC=1
SWE_CKPT_INTERVAL=5
# The pool, not the dataset, follows the mix: off so nothing else reads live.jsonl.
SWE_DATA_HOT_RELOAD=0
SWE_ROLLOUT_RECORDS=1
SWE_EVOLUTION_SIGNALS=1
# No optimizer step on a step whose grad norm is exactly 0 (every sample had
# zero advantage): fused AdamW would otherwise keep moving the weights on it.
SWE_SKIP_ZERO_GRAD_STEP=1
