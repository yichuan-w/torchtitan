{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/torchtitan/experiments/rl/tools/issue_listener/issue_listener.py\"; [ ! -f \"$f\" ] || python3 \"$f\" hook-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/torchtitan/experiments/rl/tools/issue_listener/issue_listener.py\"; [ ! -f \"$f\" ] || python3 \"$f\" hook-stop",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
