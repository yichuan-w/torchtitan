    {
     "type": "null"
    },
    {
     "type": "string",
     "pattern": "^(instruction\\.md|setup\\.sh|tests/test\\.sh):[0-9]+(-[0-9]+)?\\b"
    }
   ]
  },
  "overspecific_check": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "string",
     "pattern": "^(instruction\\.md|setup\\.sh|tests/test\\.sh):[0-9]+(-[0-9]+)?\\b"
    }
   ]
  },
