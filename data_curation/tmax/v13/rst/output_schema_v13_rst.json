    {
     "type": "string",
     "pattern": "^(instruction\\.md|setup\\.sh|tests/test\\.sh):[0-9]+(-[0-9]+)?\\b"
    }
   ]
  },
  "protected_paths": {
   "type": "array",
   "uniqueItems": true,
   "items": {
    "type": "string",
    "pattern": "^/[^\\s*?]*[^\\s*?/]$",
    "not": {
     "enum": [
      "/",
      "/app",
      "/home",
      "/home/user",
      "/opt",
      "/tmp",
      "/workspace",
      "/srv",
      "/var",
      "/root",
      "/usr",
      "/usr/local",
      "/data",
      "/mnt",
      "/etc"
