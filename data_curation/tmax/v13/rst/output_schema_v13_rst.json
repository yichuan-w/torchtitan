    {
     "type": "null"
    },
    {
     "type": "string",
     "pattern": "^(instruction\\.md|setup\\.sh|tests/test\\.sh):[0-9]+(-[0-9]+)?\\b"
    }
   ]
  },
  "bootstrap_fetch": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "string",
     "pattern": "^tests/test\\.sh:[0-9]+(-[0-9]+)?\\b",
