{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "rst-seed-audit-row-v13-rst",
 "title": "RST seed audit row, rubric v13-rst",
 "description": "One row per task. Blocking: A1 A2 A3 B1 B3. Notes (no tier or verdict effect): A4 A6 A7. bootstrap_fetch: harness record, no tier or verdict effect, in no cross-field rule.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "task_id",
  "agent",
  "rubric_version",
  "core_step",
  "assertions",
  "last_assert_line",
  "expectation_source",
  "literal_derivation",
  "excluded_material",
  "oracle_reachable",
  "expectation_revealed",
  "value_derivable",
  "overspecific_check",
  "unstable_reward",
  "bootstrap_fetch",
  "expectation_movable",
  "protected_paths",
  "weak_verifier_exploit",
  "core_clause_unenforced",
  "ambiguity",
  "uncertain_fact",
  "evidence",
  "evidence_file",
  "evidence_line",
  "reason",
  "repro_cmd",
  "repro_expected",
  "exploit_status",
  "pass_probe",
  "verdict",
  "tier"
 ],
 "properties": {
  "task_id": {
   "type": "string",
   "pattern": "^rts_task_[0-9a-f]{8,32}$"
  },
  "agent": {
   "type": "string",
   "minLength": 1
  },
  "rubric_version": {
   "const": "v13-rst"
  },
  "core_step": {
   "type": "string",
   "minLength": 8
  },
  "assertions": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "pattern": "^L[0-9]+(-[0-9]+)?: "
   }
  },
  "last_assert_line": {
   "type": "integer",
   "minimum": 1
  },
  "expectation_source": {
   "enum": [
    "test_only",
    "hardcoded_literal",
    "rollout_material",
    "shape_only"
   ]
  },
  "literal_derivation": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "string",
     "pattern": "^(derived|unverified): "
    }
   ]
  },
  "excluded_material": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "path",
     "exclusion",
     "basis"
    ],
    "properties": {
     "path": {
      "type": "string",
      "minLength": 1
     },
     "exclusion": {
      "enum": [
       "instructed_tool",
       "library_to_wrap",
       "buggy_premise",
       "expected_edit",
       "toolchain",
       "grade_time_generated",
       "removed_before_rollout",
       "derivation_is_core_step",
       "benign"
      ]
     },
     "basis": {
      "type": "string",
      "pattern": "^(instruction\\.md|setup\\.sh|tests/test\\.sh):[0-9]+(-[0-9]+)?\\b"
     }
    }
   }
  },
  "oracle_reachable": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "string",
     "pattern": "^(instruction\\.md|setup\\.sh|tests/test\\.sh):[0-9]+(-[0-9]+)?\\b"
    }
   ]
  },
  "expectation_revealed": {
   "anyOf": [
    {
     "type": "null"
    },
    {
     "type": "string",
     "pattern": "^(instruction\\.md|setup\\.sh|tests/test\\.sh):[0-9]+(-[0-9]+)?\\b"
    }
   ]
  },
  "value_derivable": {
