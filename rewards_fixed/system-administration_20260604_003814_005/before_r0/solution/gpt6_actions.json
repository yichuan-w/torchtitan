  },
  {
    "step_id": 6,
    "offset_sec": 41.3,
    "keystrokes": "KEY=$(gpg --list-secret-keys --with-colons | awk -F: '/^sec/{print $5; exit}'); echo \"KEY=$KEY\"\n",
    "duration": 0.1,
    "kind": "terminal_action"
  },
  {
    "step_id": 6,
    "offset_sec": 41.3,
    "keystrokes": "cd /var/www/repo && rm -f dists/stable/InRelease dists/stable/Release.gpg && dpkg-scanpackages pool /dev/null > dists/stable/main/binary-amd64/Packages && cat dists/stable/main/binary-amd64/Packages\n",
    "duration": 2.0,
    "kind": "terminal_action"
  },
  {
    "step_id": 6,
    "offset_sec": 41.3,
    "keystrokes": "apt-ftparchive -o APT::FTPArchive::Release::Origin=\"Local Repo\" -o APT::FTPArchive::Release::Label=\"Local Repo\" -o APT::FTPArchive::Release::Suite=\"stable\" -o APT::FTPArchive::Release::Codename=\"stable\" -o APT::FTPArchive::Release::Architectures=\"amd64\" -o APT::FTPArchive::Release::Components=\"main\" -o APT::FTPArchive::Release::Description=\"Local APT Repository\" release dists/stable > dists/stable/Release && cat dists/stable/Release\n",
    "duration": 3.0,
    "kind": "terminal_action"
  },
  {
    "step_id": 6,
    "offset_sec": 41.3,
    "keystrokes": "gpg --batch --yes --default-key $KEY --clearsign -o dists/stable/InRelease dists/stable/Release && gpg --batch --yes --default-key $KEY -abs -o dists/stable/Release.gpg dists/stable/Release && ls -la dists/stable/\n",
    "duration": 3.0,
    "kind": "terminal_action"
  },
  {
    "step_id": 6,
    "offset_sec": 41.3,
    "keystrokes": "gpg --export $KEY > /etc/apt/trusted.gpg.d/local-repo.gpg && gpg --export $KEY > /usr/share/keyrings/local-repo.gpg && ls -la /etc/apt/trusted.gpg.d/\n",
