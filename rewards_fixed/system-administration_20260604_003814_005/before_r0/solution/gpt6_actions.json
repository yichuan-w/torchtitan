  {
    "step_id": 6,
    "offset_sec": 41.3,
    "keystrokes": "gpg --batch --gen-key <<'EOF'\nKey-Type: RSA\nKey-Length: 2048\nName-Real: Local Repo\nName-Email: repo@localhost\nExpire-Date: 0\n%no-protection\n%commit\nEOF\n",
