  },
  {
    "step_id": 5,
    "offset_sec": 33.1,
    "keystrokes": "find / -xdev \\( -name \"secring.gpg\" -o -name \"private-keys-v1.d\" -o -name \"*.asc\" \\) 2>/dev/null | grep -v -E '^/(proc|sys|usr/share/doc)'; ls -la /root/.gnupg 2>/dev/null\n",
