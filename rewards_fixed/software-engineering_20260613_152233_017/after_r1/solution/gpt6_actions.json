    "keystrokes": "python3 - <<'PY'\nfrom pathlib import Path\n\npath = Path('/app/calc/calc.c')\ns = path.read_text()\n\nold = '''int main(void) {\n    Env *global = env_new(NULL);\n    char *line;\n\n    while ((line = read_line(stdin)) != NULL) {\n        Expr *expr = parse_line(line);\n        Value value = eval(global, expr);\n\n        if (value.type == VAL_FUNC) {\n            printf(\"0\\\\n\");\n        } else {\n            printf(\"%lld\\\\n\", value.num);\n        }\n\n        free(line);\n    }\n\n    return 0;\n}\n'''\n\nnew = '''int main(void) {\n    Env *global = env_new(NULL);\n    char *line;\n    char *buf = NULL;\n    size_t cap = 0;\n    size_t len = 0;\n    int depth = 0;\n\n    while ((line = read_line(stdin)) != NULL) {\n        size_t line_len = strlen(line);\n        size_t need = len + line_len + 2;\n        size_t i;\n\n        if (need > cap) {\n            while (cap < need) {\n                cap = cap ? cap * 2 : 128;\n            }\n            buf = xrealloc(buf, cap);\n        }\n\n        if (len > 0) {\n            buf[len++] = ' ';\n        }\n        memcpy(buf + len, line, line_len);\n        len += line_len;\n        buf[len] = '\\\\0';\n\n        for (i = 0; i < line_len; i++) {\n            if (line[i] == '(') {\n                depth++;\n            } else if (line[i] == ')') {\n                depth--;\n                if (depth < 0) {\n                    fail();\n                }\n            }\n        }\n\n        free(line);\n\n        if (depth == 0) {\n            Value value;\n            Expr *expr;\n\n            if (len == 0) {\n                continue;\n            }\n\n            expr = parse_line(buf);\n            value = eval(global, expr);\n\n            if (value.type == VAL_FUNC) {\n                printf(\"0\\\\n\");\n            } else {\n                printf(\"%lld\\\\n\", value.num);\n            }\n\n            len = 0;\n            buf[0] = '\\\\0';\n        }\n    }\n\n    if (depth != 0 || len != 0) {\n        fail();\n    }\n\n    free(buf);\n    return 0;\n}\n'''\n\nif old not in s:\n    raise SystemExit('old main not found')\npath.write_text(s.replace(old, new, 1))\nPY\n",
