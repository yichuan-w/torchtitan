  {
    "step_id": 26,
    "offset_sec": 2.9,
    "keystrokes": "echo 'def normalize(text):' | tee -a /home/user/pipeline.py\n",
    "duration": 0.1,
    "kind": "terminal_action"
  },
  {
    "step_id": 26,
    "offset_sec": 2.9,
    "keystrokes": "echo '    text = text.lower()' | tee -a /home/user/pipeline.py\n",
    "duration": 0.1,
    "kind": "terminal_action"
  },
  {
    "step_id": 26,
    "offset_sec": 2.9,
    "keystrokes": "echo '    text = re.sub(r\"[^a-z0-9]+\", \" \", text)' | tee -a /home/user/pipeline.py\n",
    "duration": 0.1,
    "kind": "terminal_action"
  },
  {
    "step_id": 26,
    "offset_sec": 2.9,
    "keystrokes": "echo '    return \" \".join(text.split())' | tee -a /home/user/pipeline.py\n",
    "duration": 0.1,
    "kind": "terminal_action"
  },
  {
    "step_id": 26,
    "offset_sec": 2.9,
    "keystrokes": "echo '' | tee -a /home/user/pipeline.py\n",
    "duration": 0.1,
    "kind": "terminal_action"
  },
  {
    "step_id": 26,
    "offset_sec": 2.9,
    "keystrokes": "echo 'def strip_quantity(text):' | tee -a /home/user/pipeline.py\n",
    "duration": 0.1,
    "kind": "terminal_action"
  },
  {
    "step_id": 26,
    "offset_sec": 2.9,
    "keystrokes": "echo '    return re.sub(r\"^\\s*\\d+\\s*[xX]\\s*\", \"\", text).strip()' | tee -a /home/user/pipeline.py\n",
    "duration": 0.1,
    "kind": "terminal_action"
  },
  {
    "step_id": 28,
    "offset_sec": 4.0,
    "keystrokes": "printf '%s\\n' '' 'def levenshtein(a, b):' '    prev = list(range(len(b) + 1))' '    for i, ca in enumerate(a, 1):' '        cur = [i]' '        for j, cb in enumerate(b, 1):' '            cur.append(min(prev[j] + 1, cur[-1] + 1, prev[j - 1] + (ca != cb)))' '        prev = cur' '    return prev[-1]' | tee -a /home/user/pipeline.py\n",
    "duration": 0.1,
    "kind": "terminal_action"
  },
  {
    "step_id": 29,
    "offset_sec": 4.1,
    "keystrokes": "printf '%s\\n' '' 'def similarity(a, b):' '    lev_ratio = 1.0 - levenshtein(a, b) / max(len(a), len(b), 1)' '    seq_ratio = SequenceMatcher(None, a, b).ratio()' '    return 0.45 * lev_ratio + 0.55 * seq_ratio' | tee -a /home/user/pipeline.py\n",
    "duration": 0.1,
    "kind": "terminal_action"
  },
  {
    "step_id": 31,
    "offset_sec": 4.2,
    "keystrokes": "cat /home/user/pipeline.py\n",
    "duration": 0.1,
    "kind": "terminal_action"
  },
  {
