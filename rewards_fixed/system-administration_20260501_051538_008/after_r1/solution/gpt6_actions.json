  {
    "step_id": 7,
    "offset_sec": 17.3,
    "keystrokes": "cat > /app/start-tunnel.sh <<'EOF'\n#!/bin/bash\n# Start SSH reverse tunnels for the internal dashboard, API, and metrics services.\n# Usage: ./start-tunnel.sh\n\nKEY=\"/root/.ssh/id_rsa\"\n\nexec ssh -N \\\n    -i \"$KEY\" \\\n    -o BatchMode=yes \\\n    -o StrictHostKeyChecking=no \\\n    -o UserKnownHostsFile=/dev/null \\\n    -o ExitOnForwardFailure=yes \\\n    -o ServerAliveInterval=30 \\\n    -o ServerAliveCountMax=3 \\\n    -R 127.0.0.1:9090:127.0.0.1:8080 \\\n    -R 127.0.0.1:9091:127.0.0.1:3000 \\\n    -R 127.0.0.1:9092:127.0.0.1:5000 \\\n    tunnel@localhost\nEOF\nchmod +x /app/start-tunnel.sh\ncat /app/start-tunnel.sh\n",
