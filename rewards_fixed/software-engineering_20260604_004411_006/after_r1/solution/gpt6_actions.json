    "step_id": 6,
    "offset_sec": 3.8,
    "keystrokes": "cat > src/strsplit.c << 'EOF'\n#include \"strlib.h\"\n#include <stdlib.h>\n#include <string.h>\n\nchar **strsplit(const char *s, char delim, size_t *count) {\n    if (!s || !count) return NULL;\n    size_t n = 1;\n    for (const char *p = s; *p; p++)\n        if (*p == delim) n++;\n    char **result = malloc((n + 1) * sizeof(char *));\n    if (!result) return NULL;\n    size_t idx = 0;\n    const char *p = s;\n    for (;;) {\n        const char *start = p;\n        while (*p && *p != delim) p++;\n        size_t len = p - start;\n        result[idx] = malloc(len + 1);\n        if (result[idx]) { memcpy(result[idx], start, len); result[idx][len] = '\\0'; }\n        idx++;\n        if (!*p) break;\n        p++;\n    }\n    result[idx] = NULL;\n    *count = idx;\n    return result;\n}\n\nvoid strsplit_free(char **parts) {\n    if (!parts) return;\n    for (size_t i = 0; parts[i]; i++) free(parts[i]);\n    free(parts);\n}\nEOF\n",
