    "keystrokes": "cat > /etc/logrotate.d/myapp <<'EOF'\n/var/log/myapp/app.log {\n    size 10M\n    rotate 7\n    nodateext\n    copytruncate\n    compress\n    delaycompress\n    missingok\n    notifempty\n}\n\n/var/log/myapp/access.log {\n    daily\n    rotate 7\n    copytruncate\n    compress\n    delaycompress\n    missingok\n    notifempty\n}\n\n/var/log/myapp/error.log {\n    weekly\n    rotate 4\n    copytruncate\n    compress\n    delaycompress\n    missingok\n    notifempty\n}\nEOF\nchmod 644 /etc/logrotate.d/myapp\n",
